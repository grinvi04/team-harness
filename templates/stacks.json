        "django": {
          "uiModes": [
            "templates",
            "htmx",
            "api"
          ],
          "defaultUi": "templates",
          "steps": "templates/stacks/python/frameworks/django/ci/steps.yml",
          "rules": [],
          "versionComponents": {
            "django": {
              "ecosystem": "pypi",
              "packageName": "django",
              "required": true
            }
          }
        },
        "fastapi": {
          "uiModes": [
            "api"
          ],
          "defaultUi": "api",
          "steps": "templates/stacks/python/frameworks/fastapi/ci/steps.yml",
          "rules": [],
          "versionComponents": {
            "fastapi": {
              "ecosystem": "pypi",
              "packageName": "fastapi",
              "required": true
            }
          }
        },
        "flask": {
          "uiModes": [
            "templates",
            "api"
          ],
          "defaultUi": "templates",
          "steps": "templates/stacks/python/frameworks/flask/ci/steps.yml",
          "rules": [],
          "versionComponents": {
            "flask": {
              "ecosystem": "pypi",
              "packageName": "flask",
              "required": true
            }
          }
        }
      },
      "versionComponents": {
        "python": {
          "ecosystem": "python",
          "required": false
        }
      }
