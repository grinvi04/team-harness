{
  "schemaVersion": 1,
  "commonChecks": [
    "test-guard",
    "commitlint-trusted",
    "integration-e2e",
    "destructive-ddl"
  ],
  "commonSources": {
    "workflow": "common/workflow.yml",
    "secretScan": "common/secret-scan.yml"
  },
  "frontendPresets": {
    "node": {
      "label": "React / Vite (generic Node.js)",
      "rules": [
        "typescript"
      ]
    },
    "vue": {
      "label": "Vue / Nuxt",
      "rules": [
        "typescript",
        "vue"
      ]
    },
    "nextjs": {
      "label": "Next.js",
      "rules": [
        "typescript",
        "nextjs"
      ]
    }
  },
  "stacks": [
    {
      "id": 1,
      "label": "Node.js 단독      — React / Vite SPA, NestJS 단독 API",
      "template": "ci-gate-node.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "typescript"
      ],
      "backend": {
        "preset": "node"
      },
      "frontend": {
        "preset": null,
        "default": null
      },
      "database": {
        "tool": null,
        "checks": []
      },
      "frontendOptions": [],
      "sources": {
        "header": "headers/node.yml",
        "jobs": [
          "jobs/node.yml"
        ]
      }
    },
    {
      "id": 2,
      "label": "NestJS 풀스택     — NestJS 백엔드 + React / Vue / Next.js 프론트엔드",
      "template": "ci-gate-nestjs-frontend.yml",
      "checks": [
        "backend",
        "frontend",
        "secret-scan"
      ],
      "rules": [
        "typescript",
        "prisma"
      ],
      "backend": {
        "preset": "nestjs"
      },
      "frontend": {
        "preset": "node",
        "default": "node"
      },
      "database": {
        "tool": "prisma",
        "checks": []
      },
      "frontendOptions": [
        "node",
        "vue",
        "nextjs"
      ],
      "sources": {
        "header": "headers/nestjs-frontend.yml",
        "jobs": [
          "jobs/nestjs-frontend-backend.yml",
          "jobs/nestjs-frontend-frontend.yml"
        ]
      }
    },
    {
      "id": 3,
      "label": "Spring Boot       — Java / Kotlin Gradle 백엔드 단독",
      "template": "ci-gate-spring.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "java",
        "flyway"
      ],
      "backend": {
        "preset": "spring"
      },
      "frontend": {
        "preset": null,
        "default": null
      },
      "database": {
        "tool": "flyway",
        "checks": [
          "migration-safety"
        ]
      },
      "frontendOptions": [],
      "sources": {
        "header": "headers/spring.yml",
        "jobs": [
          "jobs/spring.yml"
        ]
      }
    },
    {
      "id": 4,
      "label": "Spring 풀스택     — Spring Boot 백엔드 + Node.js 프론트엔드",
      "template": "ci-gate-spring-frontend.yml",
      "checks": [
        "backend",
        "frontend",
        "secret-scan"
      ],
      "rules": [
        "java",
        "flyway",
        "typescript"
      ],
      "backend": {
        "preset": "spring"
      },
      "frontend": {
        "preset": "node",
        "default": "node"
      },
      "database": {
        "tool": "flyway",
        "checks": [
          "migration-safety"
        ]
      },
      "frontendOptions": [
        "node",
        "vue",
        "nextjs"
      ],
      "sources": {
        "header": "headers/spring-frontend.yml",
        "jobs": [
          "jobs/spring-frontend-backend.yml",
          "jobs/spring-frontend-frontend.yml"
        ]
      }
    },
    {
      "id": 5,
      "label": "Python            — FastAPI / Django (+ PostgreSQL + Redis)",
      "template": "ci-gate-python.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "python",
        "alembic"
      ],
      "backend": {
        "preset": "python"
      },
      "frontend": {
        "preset": null,
        "default": null
      },
      "database": {
        "tool": "alembic",
        "checks": [
          "alembic-heads"
        ]
      },
      "frontendOptions": [],
      "sources": {
        "header": "headers/python.yml",
        "jobs": [
          "jobs/python.yml"
        ]
      }
    },
    {
      "id": 6,
      "label": "Rails 8           — 소팀 MVP · Hotwire 풀스택",
      "template": "ci-gate-rails.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "ruby"
      ],
      "backend": {
        "preset": "rails"
      },
      "frontend": {
        "preset": null,
        "default": null
      },
      "database": {
        "tool": null,
        "checks": []
      },
      "frontendOptions": [],
      "sources": {
        "header": "headers/rails.yml",
        "jobs": [
          "jobs/rails.yml"
        ]
      }
    },
    {
      "id": 7,
      "label": "Next.js 단독      — App Router 풀스택 (RSC · server actions)",
      "template": "ci-gate-nextjs.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "typescript",
        "nextjs"
      ],
      "backend": {
        "preset": null
      },
      "frontend": {
        "preset": "nextjs",
        "default": null
      },
      "database": {
        "tool": null,
        "checks": []
      },
      "frontendOptions": [],
      "sources": {
        "header": "headers/nextjs.yml",
        "jobs": [
          "jobs/nextjs.yml"
        ]
      }
    },
    {
      "id": 8,
      "label": "Vue 3             — Vite SPA (Composition API · Pinia)",
      "template": "ci-gate-vue.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "typescript",
        "vue"
      ],
      "backend": {
        "preset": null
      },
      "frontend": {
        "preset": "vue",
        "default": null
      },
      "database": {
        "tool": null,
        "checks": []
      },
      "frontendOptions": [],
      "sources": {
        "header": "headers/vue.yml",
        "jobs": [
          "jobs/vue.yml"
        ]
      }
    }
  ]
}
