{
  "schemaVersion": 3,
  "commonChecks": [
    "test-guard",
    "commitlint-trusted",
    "integration-e2e",
    "destructive-ddl"
  ],
  "commonSources": {
    "workflow": "templates/ci/common/workflow.yml",
    "secretScan": "templates/ci/common/secret-scan.yml"
  },
  "stacks": [
    {
      "id": 1,
      "label": "Node.js 단독      — React / Vite SPA, NestJS 단독 API",
      "template": "ci-gate-node.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "typescript"
      ],
      "backend": {
        "preset": "node"
      },
      "frontend": {
        "preset": null,
        "default": null
      },
      "database": {
        "tool": null,
        "checks": []
      },
      "sources": {
        "header": "templates/stacks/node/ci/header.yml",
        "jobs": [
          "templates/stacks/node/ci/quality.yml"
        ]
      },
      "key": "node",
      "roles": [
        "backend",
        "frontend"
      ],
      "assetSources": {},
      "versionComponents": {
        "node": {
          "ecosystem": "node",
          "required": false
        }
      }
    },
    {
      "id": 2,
      "label": "Spring Boot       — Java / Kotlin Gradle 백엔드 단독",
      "template": "ci-gate-spring-boot.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "java",
        "flyway"
      ],
      "backend": {
        "preset": "spring-boot"
      },
      "frontend": {
        "preset": null,
        "default": null
      },
      "database": {
        "tool": "flyway",
        "checks": [
          "migration-safety"
        ]
      },
      "sources": {
        "header": "templates/stacks/spring-boot/ci/header.yml",
        "jobs": [
          "templates/stacks/spring-boot/ci/quality.yml"
        ]
      },
      "key": "spring-boot",
      "roles": [
        "backend"
      ],
      "assetSources": {
        "dockerfile": "templates/stacks/spring-boot/Dockerfile",
        "gitignore": "templates/stacks/spring-boot/gitignore",
        "checkstyle": "templates/stacks/spring-boot/checkstyle.xml"
      },
      "localCheck": "templates/stacks/spring-boot/local-check.sh",
      "versionComponents": {
        "java": {
          "ecosystem": "java",
          "required": false
        },
        "spring-boot": {
          "ecosystem": "spring-boot",
          "required": false
        },
        "gradle": {
          "ecosystem": "gradle",
          "required": false
        }
      }
    },
    {
      "id": 3,
      "label": "Python            — FastAPI / Django (+ PostgreSQL + Redis)",
      "template": "ci-gate-python.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "python",
        "alembic"
