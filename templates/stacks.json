{
  "schemaVersion": 3,
  "commonChecks": [
    "test-guard",
    "commitlint-trusted",
    "integration-e2e",
    "destructive-ddl"
  ],
  "commonSources": {
    "workflow": "templates/ci/common/workflow.yml",
    "secretScan": "templates/ci/common/secret-scan.yml"
  },
  "stacks": [
    {
      "id": 1,
      "label": "Node.js 단독      — React / Vite SPA, NestJS 단독 API",
      "template": "ci-gate-node.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "typescript"
      ],
      "backend": {
        "preset": "node"
      },
      "frontend": {
        "preset": null,
        "default": null
      },
      "database": {
        "tool": null,
        "checks": []
      },
      "sources": {
        "header": "templates/stacks/node/ci/header.yml",
        "jobs": [
          "templates/stacks/node/ci/quality.yml"
        ]
      },
      "key": "node",
      "roles": [
        "backend",
        "frontend"
      ],
      "assetSources": {}
    },
    {
      "id": 2,
      "label": "Spring Boot       — Java / Kotlin Gradle 백엔드 단독",
      "template": "ci-gate-spring.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "java",
        "flyway"
      ],
      "backend": {
        "preset": "spring"
      },
      "frontend": {
        "preset": null,
        "default": null
      },
      "database": {
        "tool": "flyway",
        "checks": [
          "migration-safety"
        ]
      },
      "sources": {
        "header": "templates/stacks/spring/ci/header.yml",
        "jobs": [
          "templates/stacks/spring/ci/quality.yml"
        ]
      },
      "key": "spring",
      "roles": [
        "backend"
      ],
      "assetSources": {
        "dockerfile": "templates/stacks/spring/Dockerfile",
        "gitignore": "templates/stacks/spring/gitignore",
        "checkstyle": "templates/stacks/spring/checkstyle.xml"
      },
      "localCheck": "templates/stacks/spring/local-check.sh"
    },
    {
      "id": 3,
      "label": "Python            — FastAPI / Django (+ PostgreSQL + Redis)",
      "template": "ci-gate-python.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "python",
        "alembic"
      ],
      "backend": {
        "preset": "python"
      },
      "frontend": {
        "preset": null,
        "default": null
      },
      "database": {
        "tool": "alembic",
        "checks": [
          "alembic-heads"
        ]
      },
      "sources": {
        "header": "templates/stacks/python/ci/header.yml",
        "jobs": [
          "templates/stacks/python/ci/quality.yml"
        ]
      },
      "key": "python",
      "roles": [
        "backend"
      ],
      "assetSources": {}
    },
    {
      "id": 4,
      "label": "Rails 8           — 소팀 MVP · Hotwire 풀스택",
      "template": "ci-gate-rails.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "ruby"
      ],
      "backend": {
        "preset": "rails"
      },
      "frontend": {
        "preset": null,
        "default": null
      },
      "database": {
        "tool": null,
        "checks": []
      },
      "sources": {
        "header": "templates/stacks/rails/ci/header.yml",
        "jobs": [
          "templates/stacks/rails/ci/quality.yml"
        ]
      },
      "key": "rails",
      "roles": [
        "backend"
      ],
      "assetSources": {}
    },
    {
      "id": 5,
      "label": "Next.js 단독      — App Router 풀스택 (RSC · server actions)",
      "template": "ci-gate-nextjs.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "typescript",
        "nextjs"
      ],
      "backend": {
        "preset": null
      },
      "frontend": {
        "preset": "nextjs",
        "default": null
      },
      "database": {
        "tool": null,
        "checks": []
      },
      "sources": {
        "header": "templates/stacks/nextjs/ci/header.yml",
        "jobs": [
          "templates/stacks/nextjs/ci/quality.yml"
        ]
      },
      "key": "nextjs",
      "roles": [
        "frontend"
      ],
      "assetSources": {
        "dockerfile": "templates/stacks/nextjs/Dockerfile"
      }
    },
    {
      "id": 6,
      "label": "Vue 3             — Vite SPA (Composition API · Pinia)",
      "template": "ci-gate-vue.yml",
      "checks": [
        "quality",
        "secret-scan"
      ],
      "rules": [
        "typescript",
        "vue"
      ],
      "backend": {
        "preset": null
      },
      "frontend": {
        "preset": "vue",
        "default": null
      },
      "database": {
        "tool": null,
        "checks": []
      },
      "sources": {
        "header": "templates/stacks/vue/ci/header.yml",
        "jobs": [
          "templates/stacks/vue/ci/quality.yml"
        ]
      },
      "key": "vue",
      "roles": [
        "frontend"
      ],
      "assetSources": {},
      "localCheck": "templates/stacks/vue/local-check.sh"
    }
  ],
  "pathBase": "repository-root",
  "ruleSources": {
    "typescript": "templates/rules/typescript.md",
    "java": "templates/stacks/spring/rules/java.md",
    "flyway": "templates/stacks/spring/rules/flyway.md",
    "python": "templates/stacks/python/rules/python.md",
    "alembic": "templates/stacks/python/rules/alembic.md",
    "ruby": "templates/stacks/rails/rules/ruby.md",
    "nextjs": "templates/stacks/nextjs/rules/nextjs.md",
    "vue": "templates/stacks/vue/rules/vue.md",
    "prisma": "templates/stacks/node/rules/prisma.md"
  }
}
